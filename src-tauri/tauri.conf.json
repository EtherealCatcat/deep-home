{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeepHome",
  "version": "../package.json",
  "identifier": "com.deephome.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:p5"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons-app/32x32.png",
      "icons-app/128x128.png",
      "icons-app/128x128@2x.png",
      "icons-app/icon.icns",
      "icons-app/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "resources/node": "node",
      "resources/server.mjs": "server.mjs",
      "resources/assets": "assets"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
